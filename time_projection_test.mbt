///|
// Independent vectors: tools/generate-time-projection.py --check
test "Time approximate view preserves range and nearest-even rounding" {
  let cases : Array[(String, String)] = [
    (
      "",
      "1",
    ),
    (
      "-",
      "9223372036854775809",
    ),
    (
      "",
      "9214364837600034816",
    ),
    (
      "-",
      "18437736874454810624",
    ),
    (
      "",
      "0",
    ),
    (
      "",
      "1",
    ),
    (
      "",
      "0",
    ),
    (
      "-",
      "9223372036854775808",
    ),
    (
      "",
      "1",
    ),
    (
      "",
      "4503599627370496",
    ),
    (
      "",
      "9218868437227405311",
    ),
    (
      "",
      "9218868437227405311",
    ),
    (
      "",
      "9218868437227405312",
    ),
    (
      "-",
      "18442240474082181120",
    ),
    ("9007199254740993/9007199254740992", "4607182418800017408"),
    ("9007199254740995/9007199254740992", "4607182418800017410"),
    ("1/3", "4599676419421066581"),
    ("-1/3", "13823048456275842389"),
    ("1/10", "4591870180066957722"),
    (
      "",
      "4607182418800017408",
    ),
    (
      "",
      "9218868437227405312",
    ),
    (
      "",
      "0",
    ),
    ("0/1", "0"),
  ]
  let mut failures = 0
  for i in 0..<cases.length() {
    let (text, expected_bits) = cases[i]
    let actual = @edf.Time::parse(text)
      .to_double()
      .reinterpret_as_uint64()
      .to_string()
    if actual != expected_bits {
      println(
        "projection case \{i}: actual=\{actual}, expected=\{expected_bits}",
      )
      failures += 1
    }
  }
  assert_eq(failures, 0)
}

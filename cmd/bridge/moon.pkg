import {
  "peng-jun21-b/edf" @lib,
  "moonbitlang/core/json",
  "moonbitlang/core/debug",
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "exports": [
        "report",
        "transform",
        "append_recordings",
        "review_annotations",
        "merge_recordings",
      ],
      "format": "esm",
    },
  },
)

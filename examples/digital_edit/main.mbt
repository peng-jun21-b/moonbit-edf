///|
fn main {
  let results = [
    receive(
      "plain-cross-records",
      raw_plain_edf(),
      0,
      2,
      [101, -102, 103, -104, 105],
      None,
    ),
    receive(
      "bdf-cross-records",
      raw_plain_bdf(),
      0,
      2,
      [-8388608, 8388607, -1, 0, 65536],
      None,
    ),
    receive("gaps-fast", raw_gaps_edf(), 0, 2, [7, 8, 9, 10, 11], None),
    receive("gaps-slow", raw_gaps_edf(), 2, 1, [-2, 6, 7, -8], None),
    receive(
      "bdf-gaps-interleaved",
      raw_gaps_bdf(),
      2,
      1,
      [8388607, -8388608, 257, -65537],
      None,
    ),
    receive(
      "edf-digital-extremes",
      raw_plain_edf(),
      0,
      0,
      [-32768, 32767],
      None,
    ),
    receive("last-bdf-sample", raw_plain_bdf(), 1, 5, [8388607], None),
    receive(
      "retained-tolerance",
      raw_tolerant_edf(),
      0,
      2,
      [1, 2, 3],
      Some("0.01"),
    ),
    receive("point-records", raw_points_edf(), 0, 1, [-32768, 32767], None),
    receive(
      "narrow-edf-keeps-existing-outliers",
      raw_narrow_edf(),
      0,
      2,
      [88],
      None,
    ),
    receive(
      "narrow-bdf-keeps-existing-outliers",
      raw_narrow_bdf(),
      0,
      2,
      [-999],
      None,
    ),
    receive("empty-at-beginning", raw_plain_edf(), 0, 0, [], None),
    receive("empty-at-end", raw_plain_edf(), 0, 9, [], None),
    receive("empty-no-records", raw_empty_edf(), 0, 0, [], None),
    receive("same-values", raw_plain_bdf(), 0, 0, [10, 20, 30], None),
    receive("negative-signal", raw_plain_edf(), -1, 0, [], None),
    receive("missing-signal", raw_plain_bdf(), 999, 0, [], None),
    receive("annotation-empty", raw_gaps_edf(), 1, 0, [], None),
    receive("annotation-values", raw_gaps_bdf(), 3, 0, [1], None),
    receive("annotation-only", raw_annotation_only_edf(), 0, 0, [], None),
    receive("negative-start", raw_plain_edf(), 0, -1, [], None),
    receive("past-end-empty", raw_plain_edf(), 0, 10, [], None),
    receive("int-max-start", raw_plain_edf(), 0, 2147483647, [0], None),
    receive("end-with-value", raw_plain_edf(), 0, 9, [0], None),
    receive("range-overrun", raw_plain_edf(), 0, 8, [1, 2], None),
    receive("empty-source-value", raw_empty_edf(), 0, 0, [1], None),
    receive("empty-source-start", raw_empty_edf(), 0, 1, [], None),
    receive("edf-low", raw_plain_edf(), 0, 0, [-32769], None),
    receive("edf-high", raw_plain_edf(), 0, 0, [32768], None),
    receive("bdf-low", raw_plain_bdf(), 0, 0, [-8388609], None),
    receive("bdf-high", raw_plain_bdf(), 0, 0, [8388608], None),
    receive("narrow-edf-range", raw_narrow_edf(), 0, 0, [101], None),
    receive("narrow-bdf-range", raw_narrow_bdf(), 0, 0, [-1001], None),
    receive("int-max-value", raw_plain_edf(), 0, 0, [2147483647], None),
    receive("int-min-value", raw_plain_bdf(), 0, 0, [-2147483648], None),
    receive("atomic-later-invalid", raw_gaps_edf(), 0, 0, [1, 2, 32768], None),
    receive("partial-source", raw_partial_edf(), 0, 0, [], None),
    receive("strict-jitter", raw_tolerant_edf(), 0, 0, [1], None),
  ]
  println(results.to_json().stringify())
}
